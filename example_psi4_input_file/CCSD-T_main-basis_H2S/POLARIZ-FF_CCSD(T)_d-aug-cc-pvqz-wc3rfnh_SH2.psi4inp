#### FUNCTIONS (could be moved to other file but this way its implicity portable [no need to copy multiple files])
def eval_moments(wfn):
    oeprop = psi4.core.OEProp(wfn)
    oeprop.add('MULTIPOLE(1)')
    oeprop.add('MULTIPOLE(2)')
    oeprop.add('MULTIPOLE(3)')
    oeprop.add('MULTIPOLE(4)')
    oeprop.compute()
    def my_trans(x):
        fac=1
        ar=np.array(x).reshape(tuple([3]*int(np.emath.logn(3,x.size))))
        return tag_matrix(ar) 
    new_di= dict()
    [ new_di.update(my_trans(wfn.variable(prop) ) ) for prop in ['DIPOLE', 'QUADRUPOLE', 'OCTUPOLE', 'HEXADECAPOLE'] ]
    return new_di

def get_moments(ext_pot, delta, do_mom=True):
    store_di=dict()
    ext_pot=( [ (q*delta,v) for q,v in ext_pot['charges'] ]
        if not ( ext_pot is None or ext_pot==[]) else None)
    single_point_time=time.time()
    E, wfn = energy( method , external_potentials=ext_pot , return_wfn=True , molecule=the_molecule )
    try:
        storage['about_the_run']['timings']['single_point'] = storage['about_the_run']['timings'].get('single_point', 0) + (time.time()-single_point_time)
    except Exception as ex:
        print_out(f"WARNING: could not save timing for 'single_point': {ex}")
    store_di.update(E=E)
    try:
        store_di.update(E_HF=psi4.variable("HF TOTAL ENERGY"))
        store_di.update(E_MP2=psi4.variable("MP2 TOTAL ENERGY"))
        store_di.update(E_CCSD=psi4.variable("CCSD TOTAL ENERGY"))
    except Exception as ex:
        warning=f"WARNING: Some preliminary energies (e.g. HF or MP2) not available for method CCSD(T), skipping: {str(ex)}"
        print(warning);print_out('CUSTOM '+warning) 
    if do_mom:
        # For CC and MP2 we need to update the density matrix through a gradient calculation
        time_grad=time.time()
        # we need a gradient calculation for evaluation of density matrix
        grad, wfn = gradient( method , external_potentials=ext_pot , return_wfn=True , ref_wfn=wfn , molecule=the_molecule )
        try:
            storage['about_the_run']['timings']['grad'] = storage['about_the_run']['timings'].get('grad', 0) + (time.time()-time_grad)
        except Exception as ex:
            print_out(f"WARNING: could not save timing for 'grad': {ex}")
    else: grad=None
    store_di.update(grad=grad)
    
    if do_mom:
        start_mom=time.time()
        mom= eval_moments(wfn)
        try:
            storage['about_the_run']['timings']['eval_mom'] = storage['about_the_run']['timings'].get('eval_mom', 0) + (time.time()-start_mom)
        except Exception as ex:
            print_out(f"WARNING: could not save timing for 'eval_mom': {ex}")
    else: mom=None
    store_di.update(mom=mom)
    return store_di,wfn

def tensor_tag_from_indices(indices):
    """Return the tensor tag string for a given index combination (e.g. [0,1,2] -> 'xyz')."""
    mapper = ["x", "y", "z"]
    return ''.join(mapper[i] for i in indices)

def tag_matrix(M, field=None):
    def get_val(ind):
        return float(M[tuple(ind)])
    new_M={}
    M = np.asarray(M)
    base_tag=f"@{field}" if not field is None else ''

    dims=M.shape
    # get all indices of M
    all_indices = list(np.ndindex(M.shape))
    for ind in all_indices:
        tag=tensor_tag_from_indices(ind)
        new_M.update({tag+base_tag: get_val(ind)})

    return new_M

def pol_transform(pols):
    new_pols={}
    for t,pol in pols.items():
        for k,v in pol.items():
            new_tags=tag_matrix(v, t)
            if new_tags is None: continue
            for kk,vv in new_tags.items():
                if kk in new_pols.keys(): raise Exception(f"Already defined: \'{k}\'")
                else: new_pols.update({kk:vv})
    return new_pols

def make_external_field(key, center, d):
    """ key: str (e.g. 'x', 'xx' or 'xy' )
    center: np.ndarray center of fields
    d: float separation parameter (how far are the charges from center)
    """

    def get_dir(key):
        mapper={
            'x': np.array([1.,0.,0.]),
            'y': np.array([0.,1.,0.]),
            'z': np.array([0.,0.,1.]),
        }
        return mapper[key]
    
    if len(key)==1:
        vec=get_dir(key)
        arrangement=[
            ( 1, vec),
            ( -1, -vec),
        ]
        q= d**2/2.
    elif len(key)==2:
        a,b=key[0],key[1]
        vec1, vec2=get_dir(a), get_dir(b)
        q= d**3/3
        if a==b:
            arrangement=[
                ( 1., vec1),
                ( 1., -vec1),
            ]
        else:
            arrangement=[
                ( +.5, + (vec1 + vec2)),
                ( +.5, - (vec1 + vec2)),
                ( -.5, + (vec1 - vec2)),
                ( -.5, - (vec1 - vec2)),
            ]
    else:
        raise ValueError(f"Unsupported key length: {len(key)}")

    arrangement=[
        (c*q, center+v*d/np.linalg.norm(v)) for c,v in arrangement
    ]


    return dict(
        charges=arrangement,
        center=center,
        separation=d,
    )

def get_center_of_charge(mol):
    coords=mol.full_geometry().to_array()
    center=np.sum([ mol.Z(i)/np.sum([mol.Z(i) for i in range(len(coords))]) * c for i,c in enumerate(coords) ] ,axis=0)
    return center
#### END FUNCTIONS

