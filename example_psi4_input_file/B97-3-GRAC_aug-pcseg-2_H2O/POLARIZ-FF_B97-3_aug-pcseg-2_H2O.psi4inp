    nat_orbs        = False          , # Freeze natural orbitals
    occ_tolerance   = 0              , # Freeze natural orbitals threshold
    cholesky_tolerance = 0.0001         , # Cholesky decomposition threshold (only relevant for type='cd')
    scf_type        = 'df'           ,
    reference       = 'RHF'          ,
    **dft_opts,
    **dict( (k,v) for k,v in df_opts.items() 
        if not v is None 
    ), 
    **conv_opts,
)
clean_options() # Set options to default (avoid bad surprises)
set_options(opts)
