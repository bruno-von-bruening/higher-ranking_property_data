print_out(f"INFORMATION about SET METHOD\n")
print_out('\n'.join([f"    {k}={v}" for k,v in opts.items()])) 
# Store method options
storage['settings'].update(opts)

# Starting job
def run_job():
    # External FIELD PARAMETERS
    center_of_charge = get_center_of_charge(the_molecule) # For evaluation of multipoles and setup of external field
    distance=1000.0 # Large distance to approximate uniform field
    delta_dip=1.000000E-04
    delta_qad=1.000000E-04
    storage['settings']['ff_val_dip']= delta_dip
    storage['settings']['ff_val_qad']= delta_qad
    
    # Field moments to apply finited field
    tensor_elements=[
        'x',
        'y',
        'z',
        'xx',
        'xy',
        'yy',
        'xz',
        'yz',
        'zz',
    ]
    
    psi4.set_global_option('PROPERTIES_ORIGIN', np.array(center_of_charge).tolist() )
    # vec=[ -float(x) for x in center_of_charge ]
    # the_molecule.translate(core.Vector3(vec[0],vec[1],vec[2]))
    
    # Generate external potentials (unit value will be tuned by FF value)
    pot_reg=dict() # Save all external potentials there (base version)
    for tensor_key in tensor_elements:
        pot_base = make_external_field(tensor_key, center_of_charge, d=distance)
        pot_reg.update({ tensor_key:pot_base })
    pot_reg.update( zero=None ) # zero potenial
    def make_entries_for_fields(pot, delta, do_mom):
        """ get_moments returns info di which may have additional keys for energy (starting with E_, e.g. Mp2)
        Transform info_di so that it return a dictionary with keys for method (e.g. 'HF','MP2', etc) each value containing a moments and and energy (currently only leading 'mom' available)
        """
        info_di, wfn= get_moments( pot, delta, do_mom=do_mom)
        # get all methods (follow with _ after either E or mom)
        methods=[ k.split('_')[1] for k in info_di.keys() if '_' in k ]
        out_di=dict()
        E_Z_ext=nuclear_external_point_charge_energy(wfn) # zero for HF and something for CC and MP2 (see function)
        for m in methods    :
            out_di[m]=dict(
                E= info_di.get(f"E_{m}", None),
                mom= None, #info_di.get(f"mom_{m}", None),
                delta= delta,
            )
            if any(m.lower().startswith(x) for x in ['mp','cc']) and out_di[m]['E'] is not None:
                out_di[m]['E']+=E_Z_ext 
        out_di['MAIN']=dict(
            E= info_di[f"E"],
            mom= info_di.get(f"mom", None),
            delta= delta,
        )
        if any(wfn.name().lower().startswith(x) for x in ['mp','cc']):
            out_di['MAIN']['E']+=E_Z_ext 
        return out_di, wfn
    
    def nuclear_external_point_charge_energy(wfn):
        """
        Nuclear interaction energy with external point charges.
    
        Parameters
        ----------
        wfn : psi4.core.Wavefunction
    
        Returns
        -------
        float
            Nuclear–external point charge interaction energy (Hartree)
        """
    
        # Correction not needed for HF like methods
        method = wfn.name()
        if not any( method.upper().startswith(x) for x in ["MP",'CC']):
            return 0
        elif method.upper().startswith('MP'):
            if get_global_option("MP2_TYPE") not in ['df']:
                return 0
        
    
        # External charges (if none, Psi4 returns empty arrays)
        pot=wfn.external_pot()
        mol = wfn.molecule()
        if pot is None: return 0
        else: return pot.computeNuclearEnergy(mol)
    
    # Fields plus their finite difference values 
    start_time=time.time()
    fields=['zero']+tensor_elements
    deltas=[ [0] ]+[ [1*(delta_dip if len(t)==1 else delta_qad),-1*(delta_dip if len(t)==1 else delta_qad)] for t in tensor_elements]
    save_fchk=[ [True] ]+[ (False,False) for _ in tensor_elements]
    do_moms=[ [ True ] ] + [ [ True ]*2 for _ in tensor_elements ]
    storage['settings']['properties']['did_zero_moms']= True
    storage['settings']['properties']['did_fd_moms']= True
    number_of_calculations= 1 + 2*len(tensor_elements) # zero plus positive and negative for each element
    # Evaluate wfn in external potential
    ff_reg=dict()
    cnt=0
    for i, (pot_tag,deltas, save, do_mom_ser) in enumerate(zip(fields,deltas,save_fchk,do_moms)):
        for (delta,sv,do_mom) in zip(deltas,save,do_mom_ser):
            info_di,wfn = make_entries_for_fields( pot_reg[pot_tag] , delta, do_mom=do_mom )
            if not pot_tag in ff_reg.keys(): ff_reg[pot_tag]=list()
            ff_reg[pot_tag].append(info_di)
            cnt+=1
            passed_time=time.time()-start_time
            exp_remaining_time=passed_time* (number_of_calculations-cnt)/(cnt)
            print_out(f"USER MARKER: F='{pot_tag}'*{delta}"+
            f" | {cnt}/{number_of_calculations}={(cnt)/number_of_calculations*100:.2f}%"+
            f" | time pass/remain: {datetime.timedelta(seconds=np.ceil(passed_time))}"+
             ( f" {datetime.timedelta(seconds=np.ceil(exp_remaining_time))}" if exp_remaining_time > 0 else '') +'\n' )
            if sv: # save fchk only for zero field and positive field (negative is for energy derviation) 
                try:
                    fchk_file='POLARIZ-FF_B97-3_aug-pcseg-2_H2O.fchk'
                    psi4.fchk(wfn, fchk_file)
                    if not os.path.isfile(fchk_file): raise Exception(f"fchk file was not created")
                    print_out(f"CUSTOM MARKER: Saved fchk file for '{pot_tag}' with delta={delta} as '{fchk_file}'")
                except Exception as e:
                    print_out(f"Could not save fchk file for '{pot_tag}' with delta={delta} due to {e}.")
                    fchk_file=None
                storage['files']['final_fchk']= fchk_file
    # Reshape the dictionary to have method keys (e.g. 'HF','MP2', etc) each containing a dictionary with potential tags and their info (E and mom)
    raw_di=dict()
    for pot_tag, pot_infos in ff_reg.items():
        for info_di in pot_infos:
            for method, method_info in info_di.items():
                if method not in raw_di.keys(): raw_di[method] = dict()
                if not pot_tag in raw_di[method].keys(): raw_di[method][pot_tag] = list()
                raw_di[method][pot_tag]+=[ dict( (k,v) for k,v in method_info.items() if k in ['E','mom','delta'] ) ]
    
    # Compute polarisabilities through finite differences
    # Each method (e.g. 'HF','MP2', etc) will have an entry in pol_reg with the polarisabilities through energy and through moments (if available)
    
    #FORMULAS
    def get_second_derivative(plus, minus, zero,delta):
        return float(np.round( (plus-2*zero+minus)/delta**2  , 8)+0)  # add zero to avoid -0.0
    
    def get_first_derivative(plus, minus, delta):
        return float(np.round((plus-minus)/(delta), 8)+0)  # add zero to avoid -0.0
    
    def get_derivatives_from_moments(first, second, delta):
        """ Could also get second derivative """
        pols=dict()
        for k in set(list(first.keys())+list(second.keys()) ):
            assert k in first.keys() and k in second.keys()
            pols.update({ 
                k: float(np.round(-get_first_derivative(first[k],second[k], delta=delta/2)/2,8) + 0) # divide by two according to definition of pols
            })
        return pols
    
    def perform_fd_calc(the_di):
        """Compute finite-difference derivatives and return dictionaries.
    
        Returns a dict with keys:
            - 'pol_eng': pol_through_energy
            - 'pol_mom': pol_through_moments (empty dict if gradients unavailable)
            - 'mom': mom_through_energy
        """
    
        pol_through_energy, mom_through_energy, pol_through_moments = dict(), dict(), dict() 
    
        zero_di=the_di['zero']
        assert len(zero_di)==1, f"Expected only one entry for zero field, got {len(zero_di)} with entries {zero_di}"
        zero_di=zero_di[0]
        for t in [ x for x in the_di.keys() if x.lower()!='zero']: # Tensor elements!
            # energy-based derivatives, 
            entries= the_di[t]
            # each dict of mom, E, delta 
            # unzip a sequence of (E, mom, delta) tuples produced per entry
            energies, moments, deltas = zip(*((e.get('E'), e.get('mom'), e.get('delta')) for e in entries))
            assert len(energies)==2, f"Expected 2 energy entries for plus and minus field, got {len(energies)} for tag {t} with entries {entries}"
            assert deltas[0]==-deltas[1], f"Expected deltas to be symmetric for plus and minus field, got {deltas} for tag {t} with entries {entries}"
            
            pol_through_energy[f"{t}@{t}"] = -get_second_derivative( energies[0], energies[1], zero_di.get('E'), deltas[0]-zero_di.get('delta') ) # negative due to convention
            mom_through_energy[f"{t}"] = get_first_derivative( energies[0], energies[1], deltas[0]-deltas[1] )
    
    
            found=([ (x,delta) for x,delta in zip(moments, deltas) if not x is None])
            # If one do two simple FF if two do both sides (removes square term)
            if len(found)==0:
                pol_through_moments[f"{t}@{t}"] = None
            elif len(found)>2:
                raise Exception(f"Expected at most 2 moment entries for plus and minus field, got {len(found)} for tag {t} with entries {entries}")
            else:
                if len(found)==1:
                    delta=found[0][1]-zero_di['delta']
                    diffs= get_derivatives_from_moments(found[0][0], zero_di['mom'], delta)
                elif len(found)==2:
                    delta=found[0][1]-found[1][1]
                    diffs= get_derivatives_from_moments(found[0][0], found[1][0], delta)
                for d,v in diffs.items():
                    pol_through_moments[f"{d}@{t}"] = v
    
            # optionally get polarisabilities from moments if available
    
        return dict(
            pol_eng= pol_through_energy,
            pol_mom= pol_through_moments,
            mom= mom_through_energy
        )
    
    #BODY
    pol_reg=dict()
    for method in raw_di.keys():
        pol_reg[method] = perform_fd_calc(raw_di[method])
    #Store object
    storage['results']['properties']['expansion_center']= [ float(x) for x in center_of_charge]
    for method, values in pol_reg.items():
        method_prefix = method+'_' if method != 'MAIN' else '' # MAIN is the reference method, so we don't add a prefix to it
        for key, val in values.items():
            if key.startswith('pol_eng'): 
                store_key = f"{method_prefix}MolPol_FinFie_through_eng"
            elif key.startswith('pol_mom'): 
                store_key = f"{method_prefix}MolPol_FinFie_through_dens"
            elif key.startswith('mom'): 
                store_key = f"{method_prefix}MolMom_FinFie_through_eng"
            storage['results']['properties'][store_key]= ( val if any( x is not None for x in val.values() ) else None )
    # Optionally store the moments as well (only for single point with gradient available, as we only get the moments for the positive field, which are not suitable for finite difference derivatives but may be interesting on their own)
    zero_mom=raw_di['MAIN']['zero'][0]['mom']
    if zero_mom is not None: zero_mom = dict( (k, float(np.round(v,8)+0)) for k,v in zero_mom.items() ) # round and add zero to avoid -0.0
    storage['results']['properties']['MolMom_from_dens']= zero_mom

# Execute the job
try:
    start_polariz_ff=time.time()
    run_job()
    storage['about_the_run']['timings']['Total Time for POLARIZ-FF']= time.time() - start_polariz_ff
except KeyboardInterrupt as ex: # if a worker is killed then clean up the scratch!
    clean(); raise KeyboardInterrupt(f"Job was interrupted by KeyboardInterrupt")
finally: clean() # I allways want to clean up the scratch

# Dump storage at the end of the run
try:
    dump_storage()
except Exception as ex: raise Exception(f"Could not dump storage: {ex}")
finally: clean()